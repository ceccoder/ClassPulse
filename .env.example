# ClassPulse Environment Variables Example
# Copy this file to .env and fill in your configuration values

# Backend Server Port
PORT=8000

# Database Connection (SQLite by default, PostgreSQL supported)
# SQLite: sqlite+aiosqlite:///./classpulse.db
# PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/classpulse
DATABASE_URL=sqlite+aiosqlite:///./classpulse.db

# YouTube Data API v3 Key (Obtain from Google Cloud Console)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Frontend API URL (for Vite build/production)
VITE_API_URL=http://localhost:8000
